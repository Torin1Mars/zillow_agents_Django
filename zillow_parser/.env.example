DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

DB_NAME=zillow_parser
DB_USER=postgres
DB_PASSWORD=replace-me
DB_HOST=127.0.0.1
DB_PORT=5432

# Configure only a data source whose terms/license authorize automated access.
# Must contain {location}, for example: https://approved-provider.example/search?location={location}
ZILLOW_SEARCH_URL_TEMPLATE=
AUTHORIZED_DATA_SOURCE=false

PARSER_DELAY_MIN=1
PARSER_DELAY_MAX=6
HTTP_TIMEOUT=20
